{
  "name": "kilomita",
  "version": "0.0.0",
  "private": true,
  "description": "KiloMita: a light, honest internet speed test for Nigeria.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kleenpulse/kilomita.git"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=20.9"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts"
  ],
  "trustedDependencies": [],
  "scripts": {
    "dev": "turbo run dev --filter=@kilomita/web",
    "build": "turbo run build",
    "start": "bun --filter @kilomita/web start",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "licenses": "bun scripts/check-licenses.ts",
    "tripwire": "bun scripts/tripwire.ts",
    "load-test": "bun scripts/load-test.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10"
  }
}
