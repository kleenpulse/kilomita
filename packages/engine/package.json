{
  "name": "@kilomita/engine",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./limits": "./limits.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.config.json",
    "test": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=text --coverage.include=stats.ts --coverage.include=throughput.ts --coverage.include=transfer.ts --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90"
  },
  "dependencies": {
    "@kilomita/shared": "workspace:*"
  },
  "devDependencies": {
    "@kilomita/eslint-config": "workspace:*",
    "@kilomita/typescript-config": "workspace:*",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "jiti": "^2.7.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
