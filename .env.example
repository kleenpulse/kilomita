# Public base URL used for metadata and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The one request header your host sets to the visitor's IP (e.g. x-real-ip). Leave unset unless
# your host overwrites this header: a client can forge it otherwise. x-forwarded-for works only
# behind exactly one proxy.
CLIENT_IP_HEADER=

# Sharing (all server-only). Leave them unset and the test still works; sharing answers
# "Sharing isn't available right now".
#
# Neon Postgres, pooled connection string (eu-central-1, Frankfurt). Apply migrations with
# `bun --filter @kilomita/web db:migrate`.
DATABASE_URL=
# Upstash Redis REST endpoint and token (eu-central-1, Frankfurt): the daily salt, rate counters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Signs the one-time test tokens: base64 of exactly 32 random bytes. Make one with
#   bun -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RESULT_TOKEN_SECRET=
# "memory" keeps shared results in this process (PGlite plus an in-memory Redis twin) and loses
# them on restart. For local development and e2e only; never set it in production.
KILOMITA_STORES=
# "demo" (only with KILOMITA_STORES=memory) fills the memory stores with synthetic results for the
# insight pages, which then say they show sample data. Ignored with real stores.
KILOMITA_SEED=
