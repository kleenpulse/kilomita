# Public base URL used for metadata and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The one request header your host sets to the visitor's IP (x-real-ip on Vercel). Leave unset unless
# your host overwrites this header: a client can forge it otherwise. x-forwarded-for works only
# behind exactly one proxy.
CLIENT_IP_HEADER=

# Sharing (all server-only). Leave them unset and the test still works; sharing answers
# "Sharing isn't available right now".
#
# Neon Postgres, pooled connection string (eu-central-1, Frankfurt). Apply migrations with
# `bun --filter @kilomita/web db:migrate`.
DATABASE_URL=
# Upstash Redis REST endpoint and token (eu-central-1, Frankfurt): the daily salt, rate counters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Signs the one-time test tokens: base64 of exactly 32 random bytes. Make one with
#   bun -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RESULT_TOKEN_SECRET=
# "memory" keeps shared results in this process (PGlite plus an in-memory Redis twin) and loses
# them on restart. For local development and e2e only; never set it in production.
KILOMITA_STORES=
# "demo" (only with KILOMITA_STORES=memory) fills the memory stores with synthetic results for the
# insight pages, which then say they show sample data. Ignored with real stores.
KILOMITA_SEED=

# Test servers (web app, server-only, read at runtime).
# Our measurement servers (apps/server), as id=origin pairs, comma-separated, for example
#   KILOMITA_TEST_SERVERS=lagos-1=https://lagos-1.example.ng
# For local development: `bun run dev:server` and KILOMITA_TEST_SERVERS=local=http://127.0.0.1:3940
KILOMITA_TEST_SERVERS=
# "on" lets the test fall back to Cloudflare's speed test servers when none of ours answers.
# Default: on in `next dev`, off in production. Only switch it on in production after Cloudflare
# has given written permission (CLAUDE.md, launch blockers).
KILOMITA_CLOUDFLARE_FALLBACK=
# Signs the run tickets our test servers check: base64 of exactly 32 random bytes, the same value
# on the web app and on every test server. Without it, no server of ours is offered.
KILOMITA_SERVER_TICKET_SECRET=
# Vercel Cron sends "Authorization: Bearer <this>" to /api/cron/purge (the daily retention purge).
# Any long random string; unset means the cron route never runs.
CRON_SECRET=

# apps/server (the measurement server) reads these. See apps/server/deploy/DEPLOY.md.
# The web origins allowed to read its answers (CORS), comma-separated, exact.
KILOMITA_SERVER_ORIGINS=http://localhost:3000
# h1 (default, local development) or h2c (behind Caddy in production).
KILOMITA_SERVER_PROTOCOL=
# The month's transfer budget in decimal GB (about 90% of the plan's allowance). Unset: no budget.
KILOMITA_EGRESS_BUDGET_GB=
# Where the budget counter is saved (a Docker volume in production).
KILOMITA_STATE_DIR=
