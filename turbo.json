{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_SITE_URL"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "env": ["CI", "PORT", "NEXT_PUBLIC_SITE_URL"],
      "passThroughEnv": ["PLAYWRIGHT_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "PORT",
        "NEXT_PUBLIC_SITE_URL",
        "CLIENT_IP_HEADER",
        "DATABASE_URL",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "RESULT_TOKEN_SECRET",
        "KILOMITA_STORES",
        "KILOMITA_SEED",
        "KILOMITA_TEST_SERVERS",
        "KILOMITA_CLOUDFLARE_FALLBACK",
        "KILOMITA_SERVER_TICKET_SECRET",
        "KILOMITA_SERVER_ORIGINS",
        "KILOMITA_SERVER_PROTOCOL",
        "KILOMITA_EGRESS_BUDGET_GB",
        "KILOMITA_STATE_DIR",
        "HOST"
      ]
    }
  }
}
